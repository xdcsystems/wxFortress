#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @WXFORTRESS_VERSION_MAJOR@,@WXFORTRESS_VERSION_MINOR@,@WXFORTRESS_VERSION_PATCH@,@WXFORTRESS_VERSION_TWEAK@
 PRODUCTVERSION @WXFORTRESS_VERSION_MAJOR@,@WXFORTRESS_VERSION_MINOR@,@WXFORTRESS_VERSION_PATCH@,@WXFORTRESS_VERSION_TWEAK@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "xdcsystems\0"
            VALUE "FileDescription", "wxFortress - Arkanoid-style OpenGL Game\0"
            VALUE "FileVersion", "@WXFORTRESS_VERSION_NUMERIC@\0"
            VALUE "InternalName", "wxFortress\0"
            VALUE "OriginalFilename", "wxFortress.exe\0"
            VALUE "ProductName", "wxFortress\0"
            VALUE "ProductVersion", "@WXFORTRESS_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
